{
  "name": "prerender-edge",
  "version": "1.1.3",
  "description": "CLI to set up a zero-dependency prerender + sitemaps + script injection stack on Cloudflare (D1 + Workers) or Supabase (Postgres + Edge Functions)",
  "keywords": [
    "prerender", "seo", "cloudflare", "supabase", "d1", "workers",
    "bot-detection", "sitemap", "edge-functions", "react", "spa"
  ],
  "author": "DataCops Team",
  "license": "MIT",
  "homepage": "https://github.com/JoinDataCops/react-prerender-datacops#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoinDataCops/react-prerender-datacops.git"
  },
  "private": false,
  "type": "module",
  "bin": {
    "prerender-edge": "./dist/index.js"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.0.0",
    "open": "^10.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
