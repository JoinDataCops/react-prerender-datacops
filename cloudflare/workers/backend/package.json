{
  "name": "prerender-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env=",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 execute prerender-db --file=../../d1-schema.sql",
    "db:migrate:remote": "wrangler d1 execute prerender-db --remote --file=../../d1-schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240725.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  }
}
